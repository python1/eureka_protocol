[Unit]
Description=Eureka Protocol daemon
Documentation=file:///root/.openclaw/workspace/eureka_protocol/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

# --- Crash-loop guard -------------------------------------------------------
# The whole point of these two lines. Five start attempts inside five minutes
# and systemd gives up permanently, leaving the unit in `failed` for a human.
#
# This is the mistake ollama.service makes on this box: Restart=always with
# RestartSec=3 against the DEFAULT ceiling of 5 starts per 10s. One start every
# three seconds is ~3.3 per window, which never reaches 5, so the limiter never
# trips and the unit retries forever -- 124,527 times over five days.
#
# The rule: StartLimitIntervalSec must be comfortably LONGER than
# RestartSec x StartLimitBurst, or the guard is decorative. Here the five
# attempts (with backoff) span ~100s against a 300s window, so the limit is
# always reached before the window slides.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec

# Explicit, not inherited from whatever shell happened to start it. A daemon
# that picks up its identity from an operator's environment is a daemon that
# comes back as a different node when someone forgets to export a variable.
# Without this, python block-buffers stdout when it is not a terminal and the
# startup lines -- including the public key peers have to pin -- sit in a
# buffer instead of reaching the journal.
Environment=PYTHONUNBUFFERED=1
# These two are load bearing in a way that is easy to miss. The identity loader
# CREATES a key when the file it is pointed at does not exist, so a typo here
# does not fail -- it quietly mints a new identity, and the node comes back
# under a different node_id that no peer trusts. They are set explicitly, and
# they are the first thing to check if node_id ever changes.
Environment=EUREKA_IDENTITY_PATH=/var/lib/eureka/identity.key
Environment=EUREKA_TRUST_PATH=/var/lib/eureka/trust.json
WorkingDirectory=/opt/eureka

# TLS only. Plaintext on 8000 was dropped once wsl-hermes (node_ef0a1f59) was
# verified handshaking over 8443 in both directions -- in that order, because
# doing it the other way round strands the peer: an HTTPS socket answers a
# plain request with a handshake failure, not a manifest.
#
# --no-plain refuses to start without --tls-port, so a half-edit here cannot
# produce a daemon that listens on nothing and looks healthy doing it.
#
# To put plaintext back for a new peer, add the port number as the first
# argument and drop --no-plain.
ExecStart=/opt/eureka/venv/bin/python -m eureka_protocol.src.eureka_daemon.server \
    --tls-port 8443 --no-plain --tls-dir /var/lib/eureka/tls

# on-failure, not always: a clean exit 0 is somebody stopping the daemon on
# purpose, and restarting it would fight them.
Restart=on-failure
RestartSec=5s
# Back off 5s -> 60s across successive failures, so a slow dependency gets
# more room than a hard config error. The start limit above is still the
# thing that eventually says no.
RestartSteps=4
RestartMaxDelaySec=60s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eureka-daemon

# --- Identity ---------------------------------------------------------------
# A dedicated system user, no shell, no home of its own beyond the state
# directory. systemd chowns StateDirectory to this user on every start, which
# is also why the ownership cannot be pre-staged by hand: with no User= set,
# systemd chowns it straight back to root.
User=eureka
Group=eureka

# --- Hardening --------------------------------------------------------------
# ProtectHome=yes, not read-only. The daemon used to live under /root -- key
# material, interpreter and code all of it -- so /root had to stay reachable.
# Now the key material is in /var/lib/eureka and the runtime is in /opt/eureka,
# so the service has no reason to see /root, /home or /run/user at all.
#
# Opening /root up instead was the alternative, and it was rejected: /root is
# 0700 but /root/.openclaw beneath it is 0755, so making /root traversable
# would have handed the whole agent workspace to this service account and
# undone most of the point of dropping privileges.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# /var/lib/eureka, created 0700 and writable while the rest of the filesystem
# stays protected. Holds the TLS certificate and its key, both of which are
# regenerated from the identity whenever they stop matching it -- so this
# directory is derived state, safe to delete, and never the source of truth.
StateDirectory=eureka
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
